# =============================================================
# .env — Secrets pour les variables Terraform
# Ce fichier est EXCLU du git (.gitignore)
# Sourcez-le avant de lancer terraform :
#   source .env
# =============================================================

# API Token Proxmox (format: user@realm!tokenid=secret)
export TF_VAR_proxmox_api_token="root@pam!xxxxxxxxxxxxxxxxxx"

# URL de l'API Proxmox
export TF_VAR_proxmox_api_url="https://192.168.1.2:8006"
